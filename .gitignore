# Rendered output and private data never belong here
out/
private/
*.local.yml
*.html
!templates/*.j2

# Real photos: only the placeholder in examples/ is allowed
*.jpg
*.jpeg
*.png
*.webp
!examples/example-cv-*.png
!examples/example-letter.png

# PDFs: only the rendered examples
*.pdf
!examples/example-cv.pdf
!examples/example-letter.pdf

__pycache__/
.venv/
